{
  "name": "launchbox",
  "version": "1.0.0",
  "description": "A tool launcher for security researchers and developers",
  "main": "dist/main/main/index.js",
  "scripts": {
    "dev": "npm run build && electron .",
    "build:main": "tsc -p tsconfig.main.json",
    "build:renderer": "webpack --config webpack.config.js",
    "build": "npm run build:main && npm run build:renderer",
    "typecheck:main": "tsc -p tsconfig.main.json --noEmit",
    "typecheck:renderer": "tsc -p tsconfig.renderer.json --noEmit",
    "typecheck": "npm run typecheck:main && npm run typecheck:renderer",
    "lint": "eslint . --ext .js,.ts,.tsx",
    "test": "npm run build:main && node --test tests/*.test.js",
    "migrate:lily": "node scripts/import-lily.mjs",
    "start": "npm run build && electron .",
    "pack": "npm run build && electron-builder --dir",
    "dist": "npm run build && electron-builder"
  },
  "repository": {
    "type": "git",
    "url": "http://local_proxy@127.0.0.1:33437/git/wgetnz/ToolsBox"
  },
  "keywords": [
    "launcher",
    "tools",
    "security"
  ],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/node": "^25.5.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/uuid": "^10.0.0",
    "css-loader": "^7.1.4",
    "electron": "^41.0.3",
    "electron-builder": "^26.8.1",
    "eslint": "^9.39.1",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "globals": "^17.4.0",
    "html-webpack-plugin": "^5.6.6",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "style-loader": "^4.0.0",
    "ts-loader": "^9.5.4",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.57.1",
    "webpack": "^5.105.4",
    "webpack-cli": "^7.0.2"
  },
  "dependencies": {
    "electron-store": "^11.0.2",
    "uuid": "^13.0.0"
  },
  "build": {
    "appId": "com.launchbox.app",
    "productName": "LaunchBox",
    "mac": {
      "category": "public.app-category.developer-tools",
      "icon": "assets/icon.icns"
    },
    "linux": {
      "target": "AppImage",
      "icon": "assets/icon.png"
    },
    "win": {
      "target": "nsis",
      "icon": "assets/icon.ico"
    },
    "files": [
      "dist/**/*",
      "assets/**/*"
    ]
  }
}
